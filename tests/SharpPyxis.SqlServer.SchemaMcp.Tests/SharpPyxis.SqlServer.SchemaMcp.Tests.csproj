<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpPyxis.SqlServer.SchemaMcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpPyxis.SqlServer.SchemaMcp/SharpPyxis.SqlServer.SchemaMcp.csproj" />
    <!-- Built for its file only: a net48 assembly cannot be referenced from here, and is loaded into
         SQL Server by the fixture. -->
    <ProjectReference Include="../SharpPyxis.SqlServer.SchemaMcp.ClrSample/SharpPyxis.SqlServer.SchemaMcp.ClrSample.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../db/Create-DemoDatabase.sql" Link="Create-DemoDatabase.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Create-ClrObjects.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyClrSample" AfterTargets="Build">
    <Copy SourceFiles="../SharpPyxis.SqlServer.SchemaMcp.ClrSample/bin/$(Configuration)/net48/SharpPyxis.SqlServer.SchemaMcp.ClrSample.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
