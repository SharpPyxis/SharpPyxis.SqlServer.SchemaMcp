<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpPyxis.SqlServer.SchemaMcp</RootNamespace>
    <AssemblyName>schema-mcp</AssemblyName>
    <!-- SMO relies on reflection, which trimming does not follow. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- SMO brings Microsoft.Data.SqlClient (6.1.3 with SMO 181.36.0), and there is deliberately no direct
         reference to it. Raising SqlClient without SMO risks a binary mismatch the compiler does not see. -->
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.36.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpPyxis.SqlServer.SchemaMcp.Tests" />
  </ItemGroup>

</Project>
