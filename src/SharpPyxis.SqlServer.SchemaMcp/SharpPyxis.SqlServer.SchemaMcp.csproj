<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpPyxis.SqlServer.SchemaMcp</RootNamespace>
    <AssemblyName>schema-mcp</AssemblyName>
    <Version>0.1.2</Version>
    <!-- SMO relies on reflection, which trimming does not follow. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- SMO brings Microsoft.Data.SqlClient (6.1.3 with SMO 181.37.1), and there is deliberately no direct
         reference to it. Raising SqlClient without SMO risks a binary mismatch the compiler does not see. -->
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.37.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- SqlClient 6.1.3 brings Pkcs 9.0.4, under two advisories of 2026-10-13 (CVE-2026-84008 and
         CVE-2026-70162, denial of service), fixed in 10.0.13. Referenced here only to raise it: drop
         the line once SMO brings a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpPyxis.SqlServer.SchemaMcp.Tests" />
  </ItemGroup>

</Project>
